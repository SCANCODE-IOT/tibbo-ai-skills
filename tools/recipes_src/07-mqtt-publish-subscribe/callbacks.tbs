@callback_dhcp_ok
	'the library does NOT apply the address itself
	if interface <> PL_SOCK_INTERFACE_NET then exit sub
	if renew = YES and net.ip = ip then exit sub
	if renew = YES then
		sys.reboot()
	end if
	net.ip = ip
	net.netmask = netmask
	net.gatewayip = gateway_ip
	app_net_ready()
@callback_mqtt_connect_ok
	app_mqtt_connected()
@callback_mqtt_notif
	app_mqtt_message(topic, data)
