@callback_dhcp_ok
	'the library does NOT apply the address itself
	if interface <> PL_SOCK_INTERFACE_NET then exit sub
	if renew = YES and net.ip = ip then exit sub	'same address renewed: nothing to do
	if renew = YES then
		sys.reboot()				'the address changed while connections were open: start clean
	end if
	net.ip = ip
	net.netmask = netmask
	net.gatewayip = gateway_ip
	pat.play("G~", PL_PAT_CANINT)
@callback_dhcp_failure
	'no DHCP server: work with a fixed address; the library keeps trying by itself
	if interface <> PL_SOCK_INTERFACE_NET then exit sub
	if net.ip = "0.0.0.0" or net.ip = "1.0.0.1" then
		net.ip = "192.168.1.40"
		net.netmask = "255.255.255.0"
		net.gatewayip = "192.168.1.1"
	end if
	pat.play("GR", PL_PAT_CANINT)
