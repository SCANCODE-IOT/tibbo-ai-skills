include "global.tbh"

'Wi-Fi station: joins a WPA2 network, gets an address by DHCP, rejoins when the access point disappears.
'Hardware: a board with Wi-Fi (TPP2W(G2), TPP3W(G2), G3, EM2000W with the WA2000 module, WM2000).
'Change: WIFI_SSID, WIFI_PASSWORD. Sockets that must work over Wi-Fi need
'sock.targetinterface = PL_SOCK_INTERFACE_WLN (outgoing) or sock.allowedinterfaces = "WLN" (incoming).

const WIFI_SSID = "MyNetwork"
const WIFI_PASSWORD = "MyPassword"

dim wifi_retry as byte			'ticks until the next attempt to join, 0 = joined or joining

declare sub wifi_join()

'-------------------------------------------------------------------
sub on_sys_init()
	wifi_retry = 0
	wifi_join()
end sub

'-------------------------------------------------------------------
sub wifi_join()
	'the library takes the password as it is and computes the WPA key by itself (it takes a few seconds)
	if wln_start(WIFI_SSID, WLN_SECURITY_MODE_WPA2, WIFI_PASSWORD, PL_WLN_DOMAIN_FCC, YES, PL_WLN_SCAN_ALL) <> WLN_STATUS_OK then
		wifi_retry = 20				'try again in 10 s
	end if
end sub

'-------------------------------------------------------------------
sub on_sys_timer()
	dhcp_proc_timer()
	wln_proc_timer()
	if wifi_retry > 0 then
		wifi_retry = wifi_retry - 1
		if wifi_retry = 0 then wifi_join()
	end if
end sub

'-------------------------------------------------------------------
sub on_sock_data_arrival()
	dhcp_proc_data()
	wln_proc_data()
end sub

'-------------------------------------------------------------------
sub on_wln_event(wln_event as pl_wln_events)
	wln_proc_event(wln_event)
end sub

'-------------------------------------------------------------------
sub on_wln_task_complete(completed_task as pl_wln_tasks)
	wln_proc_task_complete(completed_task)
end sub
