include "global.tbh"

'DHCP on Ethernet with a fallback address. The dhcp library does the exchange; the program applies the address
'in callback_dhcp_ok (device.tbs) and falls back to a fixed address in callback_dhcp_failure.
'Hardware: any Tibbo device with Ethernet. On Wi-Fi boards the dhcp library also needs the wln library -
'tibbo_new.py adds it by itself. Change: FALLBACK_* in device.tbs.

'-------------------------------------------------------------------
sub on_sys_init()
	dhcp_start(PL_SOCK_INTERFACE_NET, "", "")	'the answer comes to callback_dhcp_ok / callback_dhcp_failure
end sub

'-------------------------------------------------------------------
sub on_sys_timer()
	dhcp_proc_timer()
	wln_proc_timer()
end sub

'-------------------------------------------------------------------
sub on_sock_data_arrival()
	dhcp_proc_data()
	wln_proc_data()
end sub

'-------------------------------------------------------------------
sub on_net_link_change()
	'cable plugged in again: ask for the address once more
	if net.linkstate <> PL_NET_LINKSTAT_NOLINK then
		dhcp_start(PL_SOCK_INTERFACE_NET, "", "")
	end if
end sub

'-------------------------------------------------------------------
sub on_wln_event(wln_event as pl_wln_events)
	wln_proc_event(wln_event)
end sub

'-------------------------------------------------------------------
sub on_wln_task_complete(completed_task as pl_wln_tasks)
	wln_proc_task_complete(completed_task)
end sub
